{
  "compilerOptions": {
    "target": "es2022",
    // TypeScript 7 removed the legacy "node"/"node10" resolver. This project is ESM and runs
    // straight off .ts via Node's type stripping (`node src/index.ts`), so nodenext is the
    // resolver that matches how the code is actually loaded — and it wants the explicit .ts
    // extensions the imports already use.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // Tests included so CI's `tsc --noEmit` checks them too; Node's type stripping never does.
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
